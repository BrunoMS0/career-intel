# Host port the Postgres container binds to. Change both this and the port in
# DATABASE_URL if something already listens on 5432.
DB_PORT=5432
DATABASE_URL=postgres://postgres:postgres@localhost:5432/career_intel

# Free key from https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Pinned rather than an alias like gemini-flash-latest, so eval runs stay
# comparable across days. Note the gemini-2.5-* line is closed to new API keys.
CHAT_MODEL=gemma-4-31b-it

# Key from https://cloud.llamaindex.ai. LlamaParse is a hosted service, so
# documents are uploaded to LlamaIndex to be parsed; ingestion needs network
# access and this key. Leave empty to keep parsing locally with unpdf.
LLAMA_CLOUD_API_KEY=

# Trial key from https://dashboard.cohere.com/api-keys. Required by the app, not
# only by the harness: `NARROW` is on in lib/retrieval.ts, so every question that
# names a posting reranks that posting's candidates before the budget, and
# without this key the chat route fails with AI_LoadAPIKeyError on exactly those
# questions. This entry used to say the app never called it, which stopped being
# true when phase 8c shipped the scoped reranker.
#
# The trial tier allows 10 calls a minute and a full `pnpm eval --rerank` pass is
# 44, so it takes five rounds with a wait between them; the harness caches every
# score in eval/rerank.json, so a rerun picks up where it stopped.
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5
